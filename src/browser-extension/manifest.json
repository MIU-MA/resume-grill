{
  "manifest_version": 3,
  "name": "Resume Grill 官网填写",
  "version": "0.2.4",
  "minimum_chrome_version": "114",
  "description": "保存个人资料，直接填写当前招聘官网；简历附件选填，也可接收工作台的批量任务。",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Resume Grill 官网填写", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } },
  "content_scripts": [{ "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_start" }]
}
