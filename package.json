{
  "name": "resume-grill",
  "private": true,
  "version": "0.1.0",
  "description": "本地优先的求职工作台：简历修改、岗位整理、邮件投递与面试练习。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "predev": "node scripts/copy-pdf-worker.mjs && npm run build:extension",
    "prebuild": "node scripts/copy-pdf-worker.mjs && npm run build:extension",
    "build:extension": "node scripts/build-website-extension.mjs",
    "dev": "next dev",
    "predev:local": "node scripts/copy-pdf-worker.mjs && npm run build:extension",
    "dev:local": "tsx scripts/workbench.ts",
    "release:assets": "node scripts/release-assets.mjs",
    "mail-agent": "tsx scripts/mail-agent.ts",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fonteditor-core": "^2.6.3",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.27.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.12",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.13.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.24",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
